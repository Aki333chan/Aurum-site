BETTER_AUTH_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://aurum_site:change-me@127.0.0.1:5432/aurum_site
EMAIL_ENABLED=false
REGISTRATION_ENABLED=false
# These switches and SMTP fields seed the database only on first start.
# After that, configure mail and registration in the site admin settings.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=Aurum Site <mailer@example.com>
PORT=3007
# For an existing deployment, pin the ID of the verified site administrator
# who owns the project. Never use the first registered account automatically.
# bootstrap:owner pins its newly created owner itself. No reassignment on restart.
SITE_OWNER_USER_ID=
# Link-only private panel bridge. Leave BOTH empty to disable it.
# Never put Pterodactyl/Companion/admin credentials here or in the browser.
AURUM_PANEL_BRIDGE_URL=
AURUM_PANEL_BRIDGE_TOKEN=
